#!/bin/sh
set -eu
if [ "$(id -u)" = 0 ]; then echo 'Run preysense-setup as the desktop user.' >&2; exit 1; fi
sudo /usr/bin/python3 -I /opt/preysense/linux/rpm_configure.py "$(id -un)"
/usr/bin/python3 /opt/preysense/linux/setup_audio.py
echo 'PreySense hardware permissions and per-user DTS setup are ready.'
